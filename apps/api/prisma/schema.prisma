generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum StatusPagamento {
  PAGO
  PENDENTE
}

model Usuario {
  id        String @id @default(uuid())
  nome      String
  email     String @unique
  senhaHash String

  refreshTokens RefreshToken[]

  categorias Categoria[]
  contas     Conta[]
  transacoes Transacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Categoria {
  id   String @id @default(uuid())
  nome String

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  transacoes Transacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("categorias")
}

model Conta {
  id   String @id @default(uuid())
  nome String

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  transacoes Transacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("contas")
}

model Transacao {
  id        String          @id @default(uuid())
  descricao String
  valor     Decimal
  data      DateTime
  tipo      TipoTransacao
  status    StatusPagamento @default(PENDENTE)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  contaId String?
  conta   Conta?  @relation(fields: [contaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@index([categoriaId])
  @@index([contaId])
  @@map("transacoes")
}
