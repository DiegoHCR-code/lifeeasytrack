generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum StatusPagamento {
  PAGO
  PENDENTE
}

enum TipoConta {
  CONTA
  CARTAO
}

enum StatusFatura {
  ABERTA
  FECHADA
  PAGA
}

model Usuario {
  id        String @id @default(uuid())
  nome      String
  email     String @unique
  senhaHash String

  refreshTokens RefreshToken[]

  categorias Categoria[]
  contas     Conta[]
  transacoes Transacao[]
  orcamentos Orcamento[]

  planosParcelamento PlanoParcelamento[]
  faturasCartao      FaturaCartao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Categoria {
  id   String @id @default(uuid())
  nome String

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  transacoes Transacao[]
  orcamentos Orcamento[]

  // Parcelamentos
  planosParcelamento PlanoParcelamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("categorias")
}

model Conta {
  id   String @id @default(uuid())
  nome String

  // ✅ Conta normal ou Cartão
  tipo TipoConta @default(CONTA)

  // ✅ Só para CARTAO (1..28)
  fechamentoDia Int?
  vencimentoDia Int?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  transacoes Transacao[]

  // Parcelamentos vinculados a esta conta (ex: cartão)
  planosParcelamento PlanoParcelamento[]

  // Faturas do cartão (se tipo = CARTAO)
  faturasCartao FaturaCartao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("contas")
}

model Transacao {
  id        String          @id @default(uuid())
  descricao String
  valor     Decimal
  data      DateTime
  tipo      TipoTransacao
  status    StatusPagamento @default(PENDENTE)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  contaId String?
  conta   Conta?  @relation(fields: [contaId], references: [id], onDelete: SetNull)

  // Parcela (se essa transação veio de um parcelamento)
  parcela Parcela?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@index([categoriaId])
  @@index([contaId])
  @@map("transacoes")
}

model Orcamento {
  id          String  @id @default(uuid())
  competencia String // "YYYY-MM" ex: "2026-02"
  limite      Decimal

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  alertas AlertaOrcamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, categoriaId, competencia])
  @@index([usuarioId, competencia])
  @@map("orcamentos")
}

model AlertaOrcamento {
  id         String  @id @default(uuid())
  percentual Int // ex: 80, 90, 100
  ativo      Boolean @default(true)

  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([orcamentoId, percentual])
  @@index([orcamentoId])
  @@map("alertas_orcamento")
}

model PlanoParcelamento {
  id                  String  @id @default(uuid())
  descricao           String
  total               Decimal
  numeroParcelas      Int
  primeiraCompetencia String // "YYYY-MM" ex: "2026-02"

  metodoPagamento String?
  estabelecimento String?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  contaId String?
  conta   Conta?  @relation(fields: [contaId], references: [id], onDelete: SetNull)

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  parcelas Parcela[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@index([contaId])
  @@index([categoriaId])
  @@map("planos_parcelamento")
}

model Parcela {
  id          String    @id @default(uuid())
  numero      Int
  competencia String // "YYYY-MM"
  valor       Decimal
  vencimento  DateTime?

  planoId String
  plano   PlanoParcelamento @relation(fields: [planoId], references: [id], onDelete: Cascade)

  // 1:1 com a transação gerada
  transacaoId String    @unique
  transacao   Transacao @relation(fields: [transacaoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([planoId, numero])
  @@index([planoId])
  @@index([competencia])
  @@map("parcelas")
}

model FaturaCartao {
  id          String @id @default(uuid())
  competencia String // "YYYY-MM" (competência do vencimento, ex: "2026-03")

  inicio     DateTime
  fim        DateTime
  fechamento DateTime
  vencimento DateTime

  status StatusFatura @default(ABERTA)

  // Dono (multi-tenant)
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Cartão
  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  totalPrevisto Decimal @default(0)
  totalPago     Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contaId, competencia])
  @@index([usuarioId, competencia])
  @@index([contaId])
  @@map("faturas_cartao")
}
