generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * =========================
 * ENUMS
 * =========================
 */

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum StatusPagamento {
  PAGO
  PENDENTE
}

enum TipoConta {
  CARTEIRA
  CONTA_CORRENTE
  CARTAO
}

enum StatusFatura {
  ABERTA
  FECHADA
  PAGA
}

enum OrigemTransacao {
  MANUAL
  PARCELA
  IMPORTACAO
  ESTORNO
  AJUSTE_SALDO
}

/**
 * =========================
 * AUTH
 * =========================
 */

model Usuario {
  id        String @id @default(uuid())
  nome      String
  email     String @unique
  senhaHash String

  refreshTokens RefreshToken[]

  categorias Categoria[]
  contas     Conta[]
  transacoes Transacao[]
  orcamentos Orcamento[]

  ajustesSaldo  AjusteSaldo[]
  logsAuditoria LogAuditoria[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  planoParcelamentos PlanoParcelamento[]
  faturaCartaos      FaturaCartao[]

  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("refresh_tokens")
}

/**
 * =========================
 * FINANCE CORE
 * =========================
 */

model Categoria {
  id   String @id @default(uuid())
  nome String

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  transacoes Transacao[]
  orcamentos Orcamento[]

  // para parcelamento (opcional)
  planosParcelamento PlanoParcelamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("categorias")
}

model Conta {
  id   String @id @default(uuid())
  nome String

  tipo TipoConta @default(CARTEIRA)

  // cartão de crédito (se tipo = CARTAO)
  fechamentoDia Int?
  vencimentoDia Int?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  transacoes Transacao[]

  // parcelamento vinculado
  planosParcelamento PlanoParcelamento[]

  // faturas do cartão
  faturasCartao FaturaCartao[]

  // ajustes de saldo
  ajustesSaldo AjusteSaldo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("contas")
}

model Transacao {
  id        String          @id @default(uuid())
  descricao String
  valor     Decimal
  data      DateTime
  tipo      TipoTransacao
  status    StatusPagamento @default(PENDENTE)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  contaId String?
  conta   Conta?  @relation(fields: [contaId], references: [id], onDelete: SetNull)

  // ✅ (1) ESTORNO + rastreabilidade
  origem              OrigemTransacao @default(MANUAL)
  estornadaEm         DateTime?
  transacaoOriginalId String?
  transacaoOriginal   Transacao?      @relation("EstornoOriginal", fields: [transacaoOriginalId], references: [id], onDelete: SetNull)
  estornos            Transacao[]     @relation("EstornoOriginal")

  // ✅ (2) ajuste de saldo pode vincular aqui
  ajusteSaldo AjusteSaldo?

  // ✅ (cartão) se você quiser linkar transação na fatura (opcional)
  faturaCartaoId String?
  faturaCartao   FaturaCartao? @relation(fields: [faturaCartaoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parcela   Parcela?

  @@index([usuarioId])
  @@index([categoriaId])
  @@index([contaId])
  @@index([transacaoOriginalId])
  @@index([faturaCartaoId])
  @@map("transacoes")
}

/**
 * =========================
 * BUDGETS + ALERTS
 * =========================
 */

model Orcamento {
  id          String  @id @default(uuid())
  competencia String // "YYYY-MM" ex: "2026-02"
  limite      Decimal

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  alertas AlertaOrcamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, categoriaId, competencia])
  @@index([usuarioId, competencia])
  @@map("orcamentos")
}

model AlertaOrcamento {
  id         String  @id @default(uuid())
  percentual Int // ex: 80, 90, 100
  ativo      Boolean @default(true)

  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([orcamentoId, percentual])
  @@index([orcamentoId])
  @@map("alertas_orcamento")
}

/**
 * =========================
 * PARCELAMENTOS
 * =========================
 */

model PlanoParcelamento {
  id                  String  @id @default(uuid())
  descricao           String
  total               Decimal
  numeroParcelas      Int
  primeiraCompetencia String // "YYYY-MM" ex: "2026-02"
  metodoPagamento     String?
  estabelecimento     String?

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  contaId String?
  conta   Conta?  @relation(fields: [contaId], references: [id], onDelete: SetNull)

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  parcelas Parcela[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@index([contaId])
  @@index([categoriaId])
  @@map("planos_parcelamento")
}

model Parcela {
  id          String    @id @default(uuid())
  numero      Int
  competencia String // "YYYY-MM"
  valor       Decimal
  vencimento  DateTime?

  planoId String
  plano   PlanoParcelamento @relation(fields: [planoId], references: [id], onDelete: Cascade)

  // 1:1 com a transação gerada
  transacaoId String    @unique
  transacao   Transacao @relation(fields: [transacaoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([planoId, numero])
  @@index([planoId])
  @@index([competencia])
  @@map("parcelas")
}

/**
 * =========================
 * CARTÃO DE CRÉDITO - FATURAS
 * =========================
 */

model FaturaCartao {
  id          String       @id @default(uuid())
  competencia String // mês do vencimento "YYYY-MM"
  status      StatusFatura @default(ABERTA)

  inicio     DateTime
  fim        DateTime
  fechamento DateTime
  vencimento DateTime

  totalPrevisto Decimal @default(0)
  totalPago     Decimal @default(0)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  // opcional: se quiser linkar transações a fatura
  transacoes Transacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contaId, competencia], name: "contaId_competencia")
  @@index([usuarioId])
  @@index([contaId, competencia])
  @@map("faturas_cartao")
}

/**
 * =========================
 * (2) AJUSTES DE SALDO
 * =========================
 */

model AjusteSaldo {
  id String @id @default(uuid())

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  contaId String
  conta   Conta  @relation(fields: [contaId], references: [id], onDelete: Cascade)

  data       DateTime
  valor      Decimal
  motivo     String
  referencia String?

  transacaoId String?    @unique
  transacao   Transacao? @relation(fields: [transacaoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([contaId])
  @@map("ajustes_saldo")
}

/**
 * =========================
 * (4) LOG DE AUDITORIA
 * =========================
 */

model LogAuditoria {
  id        String   @id @default(uuid())
  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  acao       String // ex: "TRANSACTION_REVERSE", "BALANCE_ADJUST", "INVOICE_REOPEN", "HTTP_POST"
  entidade   String // ex: "transacoes", "ajustes_saldo", "faturas_cartao", "http"
  entidadeId String?
  detalhes   Json?
  ip         String?
  userAgent  String?

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@index([acao])
  @@map("log_auditoria")
}
