generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum StatusPagamento {
  PAGO
  PENDENTE
}

model Usuario {
  id        String @id @default(uuid())
  nome      String
  email     String @unique
  senhaHash String

  refreshTokens RefreshToken[]

  categorias Categoria[]
  contas     Conta[]
  transacoes Transacao[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orcamentos Orcamento[]

  @@map("usuarios")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model Categoria {
  id   String @id @default(uuid())
  nome String

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  transacoes Transacao[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orcamentos Orcamento[]

  @@index([usuarioId])
  @@map("categorias")
}

model Conta {
  id   String @id @default(uuid())
  nome String

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  transacoes Transacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@map("contas")
}

model Transacao {
  id        String          @id @default(uuid())
  descricao String
  valor     Decimal
  data      DateTime
  tipo      TipoTransacao
  status    StatusPagamento @default(PENDENTE)

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId String?
  categoria   Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)

  contaId String?
  conta   Conta?  @relation(fields: [contaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([usuarioId])
  @@index([categoriaId])
  @@index([contaId])
  @@map("transacoes")
}

model Orcamento {
  id          String  @id @default(uuid())
  competencia String // "YYYY-MM" ex: "2026-02"
  limite      Decimal

  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  alertas AlertaOrcamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, categoriaId, competencia])
  @@index([usuarioId, competencia])
  @@map("orcamentos")
}

model AlertaOrcamento {
  id         String  @id @default(uuid())
  percentual Int // ex: 80, 90, 100
  ativo      Boolean @default(true)

  orcamentoId String
  orcamento   Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([orcamentoId, percentual])
  @@index([orcamentoId])
  @@map("alertas_orcamento")
}
